index 00000000000..856f4c894cb
--- /dev/null
+++ b/webviews/src/agent-session/acpmux/conversation/replyScan.test.ts
@@ -0,0 +1,84 @@
+// l10n-allow-file: test fixture replies, not shipped UI.
+// A streaming reply's footnote order and folders (replyScan.ts) read at the cost of its tail, with
+// the same results as a scan of its whole text. The reveal draws the reply again on every display
+// frame; reading its whole text each time made a frame cost more the longer the reply grew.
+import { expect, test } from "bun:test";
+import { IncrementalMarkdown } from "./incrementalMarkdown";
+import { footnoteOrder } from "./markdownModel";
+import { replyFolders } from "../chips/replyFolders";
+import { ReplyScan } from "./replyScan";
+import { streamedReply } from "../loadFixture";
+
+/// Streams `text` in `step`-character deltas through the parser and the scan, checking each read
+/// against the whole-text scans; returns the characters each read scanned.
+function stream(text: string, step: number): number[] {
+  const parser = new IncrementalMarkdown();
+  const scan = new ReplyScan();
+  const reads: number[] = [];
+  for (let at = step; at < text.length + step; at += step) {
+    const source = text.slice(0, at);
+    parser.advance(source, { streaming: true });
+    const read = scan.read(source, parser.closedState);
+    expect(read.noteIds).toBe(footnoteOrder(source).join(" "));
+    expect(read.folderKey).toBe(replyFolders(source).join("\n"));
+    reads.push(scan.lastReadLength);
+  }
+  return reads;
+}
+
+test("each frame of a 20,000-word reply reads its tail, not the whole reply", () => {
+  let text = "";
+  for (let turn = 1; text.split(" ").length < 20_000; turn += 1) text += streamedReply(turn, 400);
+  const parser = new IncrementalMarkdown();
+  const scan = new ReplyScan();
+  // The reply as the row first shows it, then a frame a word longer.
+  parser.advance(text, { streaming: true });
+  scan.read(text, parser.closedState);
+  for (const word of [" more", " words", " arrive", "\n\nA new paragraph starts", " and grows."]) {
+    text += word;
+    parser.advance(text, { streaming: true });
+    const read = scan.read(text, parser.closedState);
+    expect(read.folderKey).toBe(replyFolders(text).join("\n"));
+    expect(read.noteIds).toBe(footnoteOrder(text).join(" "));
+    // Its newest paragraph, at most twice (folders and notes), never the 120 KB before it.
+    expect(scan.lastReadLength).toBeLessThan(4_000);
+    expect(text.length).toBeGreaterThan(100_000);
+  }
+});
+
+test("folders and footnotes stream the same as a whole-text scan", () => {
+  const text = [
+    "Read [the plan](docs/plan.md) first.[^a]\n\n",
+    "Then `src/app/main.ts` and webviews/src/ui/Button.tsx.\n\n",
+    "A span `opens here\n\nand closes` past a blank line [^skipped] and a note.[^b]\n\n",
+    "```ts\nconst x = [^not-a-note];\n```\n\n",
+    "```\nan open fence [^inside]\n\nstill code\n```\n\n",
+    "More paths: lib/one/a.rs, lib/two/b.rs, lib/three/c.rs.[^c]\n\n",
+    "- item [^a] again\n- item [^d]\n\n",
+    "[^a]: The first note.\n\n[^b]: The second.\n",
+  ].join("");
+  for (const step of [1, 3, 17]) stream(text, step);
+});
+
+test("a fence inside a $$ display and stray backticks still match the whole-text scan", () => {
+  const text = [
+    "$$\n```\n$$\n\nprose [^x] after\n\n",
+    "one ` backtick [^y]\n\n",
+    "and its pair ` then [^z]\n\n",
+    "path/to/file.ts done.[^w]\n",
+  ].join("");
+  for (const step of [1, 5]) stream(text, step);
+});
+
+test("a reply that is replaced starts its scan over", () => {
+  const parser = new IncrementalMarkdown();
+  const scan = new ReplyScan();
+  const first = "See /repo/a/one.ts.[^a]\n\nNext paragraph.\n\n";
+  parser.advance(first, { streaming: true });
+  scan.read(first, parser.closedState);
+  const second = "Other /repo/b/two.ts.[^b]\n\nNext.\n\n";
+  parser.advance(second, { streaming: true });
+  const read = scan.read(second, parser.closedState);
+  expect(read.folderKey).toBe("/repo/b/");
+  expect(read.noteIds).toBe("b");
+});
diff --git a/webviews/src/agent-session/acpmux/conversation/replyScan.ts b/webviews/src/agent-session/acpmux/conversation/replyScan.ts
new file mode 100644
index 00000000000..57cd9bb7cec
--- /dev/null
+++ b/webviews/src/agent-session/acpmux/conversation/replyScan.ts
@@ -0,0 +1,77 @@
+// What Markdown reads off a reply's whole text (its footnote order and the folders its paths are
+// in), for a streaming reply at the cost of its tail. The reveal draws a reply again on every
+// display frame, and reading the whole text each time made a frame's cost grow with the reply:
+// at 20,000 words the folder scan alone ran its path pattern over 120 KB a frame. The closed
+// blocks' text (incrementalMarkdown.ts) never changes again, so each piece of it is read once, as
+// it closes; only the text after it is read on each frame. The results equal a scan of the whole
+// text (replyScan.test.ts): no folder pattern matches across the blank line a piece ends at, and a
+// piece adds its footnotes only once its fences and code spans close inside it (`footnotePiece`).
+import { MAX_REPLY_FOLDERS, replyFolders } from "../chips/replyFolders";
+import { footnoteOrder, footnotePiece } from "./markdownModel";
+
+export type ReplyScanResult = { noteIds: string; folderKey: string };
+
+export class ReplyScan {
+  private generation = -1;
+  /// The folders of the text before `foldersEnd`, in reading order.
+  private folders: string[] = [];
+  private foldersEnd = 0;
+  /// The footnote ids of the sealed text before `notesEnd`; `notesTried`, the closed end a piece
+  /// that was not sealed was last read to (so a frame with no new closed text does not read it again).
+  private notes: string[] = [];
+  private notesEnd = 0;
+  private notesTried = 0;
+  /// The characters the last read scanned (tests, perf).
+  lastReadLength = 0;
+
+  // perf-hot: 1ms/frame agent-chat-stream-reveal
+  /// The reply's footnote ids (space-joined) and folders (newline-joined), as Markdown keys them.
+  /// `closed` is where the parser's closed text ends and the generation it belongs to.
+  read(source: string, closed: { end: number; generation: number }): ReplyScanResult {
+    if (closed.generation !== this.generation || closed.end < this.foldersEnd || closed.end < this.notesEnd) {
+      this.generation = closed.generation;
+      this.folders = [];
+      this.foldersEnd = 0;
+      this.notes = [];
+      this.notesEnd = 0;
+      this.notesTried = 0;
+    }
+    const end = Math.min(closed.end, source.length);
+    this.lastReadLength = 0;
+    if (end > this.foldersEnd) {
+      if (this.folders.length < MAX_REPLY_FOLDERS) {
+        this.lastReadLength += end - this.foldersEnd;
+        this.folders = merge(this.folders, replyFolders(source.slice(this.foldersEnd, end)), MAX_REPLY_FOLDERS);
+      }
+      this.foldersEnd = end;
+    }
+    if (end > this.notesTried) {
+      this.notesTried = end;
+      this.lastReadLength += end - this.notesEnd;
+      const piece = footnotePiece(source.slice(this.notesEnd, end));
+      if (piece.sealed) {
+        this.notes = merge(this.notes, piece.ids);
+        this.notesEnd = end;
+      }
+    }
+    const folders =
+      this.folders.length < MAX_REPLY_FOLDERS
+        ? merge(this.folders, replyFolders(source.slice(this.foldersEnd)), MAX_REPLY_FOLDERS)
+        : this.folders;
+    if (this.folders.length < MAX_REPLY_FOLDERS) this.lastReadLength += source.length - this.foldersEnd;
+    this.lastReadLength += source.length - this.notesEnd;
+    const notes = merge(this.notes, footnoteOrder(source.slice(this.notesEnd)));
+    return { noteIds: notes.join(" "), folderKey: folders.join("\n") };
+  }
+}
+
+/// `head` followed by the entries of `more` it lacks, at most `cap` in all.
+function merge(head: string[], more: readonly string[], cap = Infinity): string[] {
+  if (!more.length) return head;
+  const out = [...head];
+  for (const entry of more) {
+    if (out.length >= cap) break;
+    if (!out.includes(entry)) out.push(entry);
+  }
+  return out;
+}
